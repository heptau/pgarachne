# ==============================================================================
# PgArachne Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration (Required)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=pgarachne

# PostgreSQL SSL mode. Default: require (TLS to the database).
# Set to "disable" only for local development against a non-TLS PostgreSQL.
# DB_SSLMODE=require

# ------------------------------------------------------------------------------
# HTTP Server Configuration
# ------------------------------------------------------------------------------
# Port for the HTTP server to listen on. Default: 8080
# HTTP_PORT=8080

# ------------------------------------------------------------------------------
# JWT (JSON Web Token) Configuration
# ------------------------------------------------------------------------------
# Secret key for signing JWTs. (Required)
# Must be at least 32 bytes; the example placeholder below is rejected at
# startup. Generate a real secret with: openssl rand -hex 32
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_SECRET_KEY"

# Token expiration time in hours. Default: 8
# JWT_EXPIRY_HOURS=8

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. No spaces around commas.
# Default: unset — cross-origin browser requests are disabled (same-origin
# and non-browser clients only). Set "*" explicitly to allow any origin.
# ALLOWED_ORIGINS="http://localhost,http://127.0.0.1"

# ------------------------------------------------------------------------------
# Static Files
# ------------------------------------------------------------------------------
# Absolute path to directory with static files (HTML, CSS, JS, images).
# If commented out, static files are not served.
# STATIC_FILES_PATH=/var/www

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARN, ERROR. Default: INFO
# LOG_LEVEL=INFO

# Log output: "stdout" or file path. Default: stdout
# LOG_OUTPUT=stdout
