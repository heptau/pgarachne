# ==============================================================================
# PgArachne Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration (Required)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=pgarachne

# PostgreSQL SSL mode. Default: require (TLS to the database).
# Set to "disable" only for local development against a non-TLS PostgreSQL.
# DB_SSLMODE=require

# ------------------------------------------------------------------------------
# HTTP Server Configuration
# ------------------------------------------------------------------------------
# Port for the HTTP server to listen on. Default: 8080
# HTTP_PORT=8080

# ------------------------------------------------------------------------------
# JWT (JSON Web Token) Configuration
# ------------------------------------------------------------------------------
# Secret key for signing JWTs. (Optional)
# Leave unset to disable JWT sessions: the get_jwt method is then unavailable
# and clients authenticate with HTTP Basic credentials or API tokens only.
# When set it must be at least 32 bytes; the example placeholder below is
# rejected at startup. Generate a real secret with: openssl rand -hex 32
# JWT_SECRET="CHANGE_THIS_TO_A_SECURE_SECRET_KEY"

# Token expiration time in hours (must be > 0). Default: 8
# JWT_EXPIRY_HOURS=8

# ------------------------------------------------------------------------------
# Login rate limiting (applies to get_jwt, HTTP Basic and Bearer auth)
# ------------------------------------------------------------------------------
# Max attempts per client IP + username per window (get_jwt: every attempt,
# Basic auth: failed attempts). Default: 5, 0 disables.
# LOGIN_RATE_LIMIT=5
# Max attempts per client IP across all usernames, including failed Bearer
# (JWT / API token) attempts. Default: 5x LOGIN_RATE_LIMIT, 0 disables.
# LOGIN_RATE_LIMIT_PER_IP=25
# LOGIN_RATE_WINDOW=1m

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. No spaces around commas.
# Default: unset — cross-origin browser requests are disabled (same-origin
# and non-browser clients only). Set "*" explicitly to allow any origin.
# ALLOWED_ORIGINS="http://localhost,http://127.0.0.1"

# ------------------------------------------------------------------------------
# Static Files
# ------------------------------------------------------------------------------
# Absolute path to directory with static files (HTML, CSS, JS, images).
# If commented out, static files are not served.
# STATIC_FILES_PATH=/var/www

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARN, ERROR. Default: INFO
# LOG_LEVEL=INFO

# Log output: "stdout" or file path. Default: stdout
# LOG_OUTPUT=stdout

# ------------------------------------------------------------------------------
# File Download (/file endpoint)
# ------------------------------------------------------------------------------
# Max total uncompressed size of one response in bytes. Default: 67108864 (64 MiB)
# FILE_MAX_BYTES=67108864
# Max number of files in one response. Default: 1000
# FILE_MAX_ENTRIES=1000
